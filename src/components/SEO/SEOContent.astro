---
import { seoContent } from '../../data/seoContent';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const data = seoContent[lang] || seoContent.en;
---

<article class="seo-container" id="seo-section">
  <div class="seo-wrapper">
    <header class="seo-header">
      <h1 class="seo-title">{data.h1}</h1>
    </header>

    <section class="seo-section" aria-labelledby="about-heading">
      <h2 id="about-heading" class="seo-section-title">{data.aboutTitle}</h2>
      {data.aboutText.map(paragraph => (
        <p class="seo-paragraph">{paragraph}</p>
      ))}
    </section>

    <section class="seo-section" aria-labelledby="features-heading">
      <h2 id="features-heading" class="seo-section-title">{data.featuresTitle}</h2>
      <div class="seo-features-grid">
        {data.features.map(feature => (
          <div class="seo-feature-card">
            <h3 class="seo-feature-title">{feature.title}</h3>
            <p class="seo-feature-text">{feature.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="seo-section" aria-labelledby="howto-heading">
      <h2 id="howto-heading" class="seo-section-title">{data.howToTitle}</h2>
      <p class="seo-paragraph">{data.howToDescription}</p>
      <ol class="seo-steps-list">
        {data.steps.map((step, index) => (
          <li class="seo-step-item" id={`step-${index + 1}`}>
            <div class="seo-step-badge" aria-hidden="true">{index + 1}</div>
            <div class="seo-step-body">
              <h3 class="seo-step-title">{step.name}</h3>
              <p class="seo-step-text">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="seo-section" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="seo-section-title">{data.faqTitle}</h2>
      <div class="seo-faq-list">
        {data.faqs.map(faq => (
          <details class="seo-faq-item">
            <summary class="seo-faq-question">
              <span>{faq.question}</span>
              <svg
                class="seo-faq-icon"
                viewBox="0 0 24 24"
                width="20"
                height="20"
                stroke="currentColor"
                stroke-width="2"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="seo-faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</article>

<style>
  .seo-container {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 4rem 1.25rem 5rem;
    color: var(--chakra-colors-bodyText, #2D3748);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    overflow-x: hidden;
  }

  :global([data-theme="dark"]) .seo-container {
    color: rgba(255, 255, 255, 0.92);
  }

  :global([data-theme="light"]) .seo-container {
    color: rgba(20, 20, 20, 0.92);
  }

  .seo-wrapper {
    max-width: 820px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .seo-header {
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .seo-title {
    font-size: clamp(1.75rem, 4vw, 2.35rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
    color: var(--chakra-colors-primary, currentColor);
  }

  .seo-section {
    margin-bottom: 3.5rem;
  }

  .seo-section-title {
    font-size: clamp(1.3rem, 3vw, 1.65rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 1.25rem;
    color: var(--chakra-colors-primary, currentColor);
  }

  .seo-paragraph {
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0 0 1rem;
    opacity: 0.88;
  }

  .seo-features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  @media (max-width: 640px) {
    .seo-features-grid {
      grid-template-columns: 1fr;
    }
  }

  .seo-feature-card {
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
    background-color: rgba(128, 128, 128, 0.05);
    border: 1px solid rgba(128, 128, 128, 0.12);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  :global([data-theme="dark"]) .seo-feature-card {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.1);
  }

  :global([data-theme="light"]) .seo-feature-card {
    background-color: rgba(0, 0, 0, 0.025);
    border-color: rgba(0, 0, 0, 0.08);
  }

  .seo-feature-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--chakra-colors-primary, currentColor);
  }

  .seo-feature-text {
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0;
    opacity: 0.82;
  }

  .seo-steps-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .seo-step-item {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
    background-color: rgba(128, 128, 128, 0.05);
    border: 1px solid rgba(128, 128, 128, 0.12);
  }

  :global([data-theme="dark"]) .seo-step-item {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.1);
  }

  :global([data-theme="light"]) .seo-step-item {
    background-color: rgba(0, 0, 0, 0.025);
    border-color: rgba(0, 0, 0, 0.08);
  }

  .seo-step-badge {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: #ED4455;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1rem;
  }

  .seo-step-body {
    flex: 1;
  }

  .seo-step-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.35rem;
    color: var(--chakra-colors-primary, currentColor);
  }

  .seo-step-text {
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0;
    opacity: 0.82;
  }

  .seo-faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 1.25rem;
  }

  .seo-faq-item {
    border-radius: 12px;
    border: 1px solid rgba(128, 128, 128, 0.12);
    background-color: rgba(128, 128, 128, 0.04);
    overflow: hidden;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }

  :global([data-theme="dark"]) .seo-faq-item {
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(255, 255, 255, 0.03);
  }

  :global([data-theme="light"]) .seo-faq-item {
    border-color: rgba(0, 0, 0, 0.08);
    background-color: rgba(0, 0, 0, 0.02);
  }

  .seo-faq-item[open] {
    border-color: rgba(237, 68, 85, 0.35);
  }

  :global([data-theme="dark"]) .seo-faq-item[open] {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(237, 68, 85, 0.45);
  }

  :global([data-theme="light"]) .seo-faq-item[open] {
    background-color: rgba(237, 68, 85, 0.02);
    border-color: rgba(237, 68, 85, 0.3);
  }

  .seo-faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.1rem 1.35rem;
    font-weight: 600;
    font-size: 1.05rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    color: var(--chakra-colors-primary, currentColor);
    transition: color 0.2s ease;
  }

  .seo-faq-question::-webkit-details-marker {
    display: none;
  }

  .seo-faq-question:hover {
    opacity: 0.9;
  }

  .seo-faq-question:focus-visible {
    outline: 2px solid #ED4455;
    outline-offset: -2px;
  }

  .seo-faq-icon {
    flex-shrink: 0;
    margin-left: 1rem;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .seo-faq-item[open] .seo-faq-icon {
    transform: rotate(180deg);
  }

  /* Modern CSS accordion animation with @starting-style and ::details-content */
  .seo-faq-item::details-content {
    transition: height 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.3s ease,
                content-visibility 0.35s allow-discrete;
    height: 0;
    overflow: clip;
    opacity: 0;
  }

  .seo-faq-item[open]::details-content {
    height: auto;
    opacity: 1;
  }

  @starting-style {
    .seo-faq-item[open]::details-content {
      height: 0;
      opacity: 0;
    }
  }

  /* Pleasant starting-style animation for inner answer content */
  .seo-faq-answer {
    padding: 0 1.35rem 1.25rem;
    font-size: 0.95rem;
    line-height: 1.65;
    opacity: 0.85;
    transform: translateY(0);
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .seo-faq-item[open] .seo-faq-answer {
    opacity: 0.88;
    transform: translateY(0);
  }

  @starting-style {
    .seo-faq-item[open] .seo-faq-answer {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .seo-faq-answer p {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .seo-faq-item::details-content,
    .seo-faq-answer,
    .seo-faq-icon {
      transition: none !important;
      transform: none !important;
    }
  }

  @media (max-width: 600px) {
    .seo-container {
      padding: 3rem 1rem 4rem;
    }
    .seo-step-item {
      padding: 1rem;
      gap: 1rem;
    }
    .seo-step-badge {
      width: 30px;
      height: 30px;
      font-size: 0.9rem;
    }
    .seo-faq-question {
      padding: 1rem;
      font-size: 0.98rem;
    }
    .seo-faq-answer {
      padding: 0 1rem 1rem;
    }
  }
</style>
