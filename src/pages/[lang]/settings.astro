---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppShell from '../../app/AppShell';
import locales from '../../data/locales';

export function getStaticPaths() {
  return [
    { params: { lang: 'ru' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params;
const locale = lang && locales[lang] ? lang : 'en';
const { settingsTitle, settingsDescription } = locales[locale];
---

<BaseLayout title={settingsTitle} description={settingsDescription} lang={locale} isSettings>
  <AppShell client:load transition:persist="pomotomo-app" locale={locale} currentView="settings" />
</BaseLayout>
