---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppShell from '../../app/AppShell';
import SEOContent from '../../components/SEO/SEOContent.astro';
import { getLocaleStaticPaths } from '../../utils/getLocaleStaticPaths';

export const getStaticPaths = getLocaleStaticPaths;

const { locale } = Astro.props;
---

<BaseLayout locale={locale}>
  <AppShell client:load transition:persist="pomotomo-app" locale={locale} currentView="timer" />
  <SEOContent lang={locale} />
</BaseLayout>
