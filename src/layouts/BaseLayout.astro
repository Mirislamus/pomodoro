---
import { ClientRouter } from 'astro:transitions';
import '../theme/typography/fonts.css';
import SchemaOrg from '../components/SEO/SchemaOrg.astro';
import locales from '../data/locales';
import meta from '../data/meta';
import { DEFAULT_LOCALE, LOCALES } from '../consts/locales';
import { Locale } from '../typings/enums';

interface Props {
  locale?: Locale;
  isSettings?: boolean;
}

const { locale = DEFAULT_LOCALE, isSettings = false } = Astro.props;
const { title, description, settingsTitle, settingsDescription } = locales[locale];
const pageTitle = isSettings ? settingsTitle : title;
const pageDescription = isSettings ? settingsDescription : description;

const siteUrl = Astro.site ? Astro.site.origin : 'https://mirislamus.github.io';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const getPageUrl = (targetLocale: Locale) =>
  `${siteUrl}${baseUrl}/${targetLocale === DEFAULT_LOCALE ? '' : `${targetLocale}/`}${isSettings ? 'settings/' : ''}`;

const alternates = LOCALES.map(targetLocale => ({ hreflang: targetLocale, href: getPageUrl(targetLocale) }));
const canonicalUrl = getPageUrl(locale);
const defaultUrl = getPageUrl(DEFAULT_LOCALE);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- No-FOUC theme initializer placed at top of head -->
    <script is:inline>
      window.__applyStoredTheme = function () {
        try {
          var savedTheme = localStorage.getItem('chakra-ui-color-mode');
          var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = savedTheme === 'system' || !savedTheme ? (systemDark ? 'dark' : 'light') : savedTheme;
          var root = document.documentElement;
          root.classList.remove('light', 'dark');
          root.classList.add(theme);
          root.setAttribute('data-theme', theme);
          root.style.colorScheme = theme;
        } catch (e) {}
      };
      window.__applyStoredTheme();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    {isSettings ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/images/favicons/favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${baseUrl}/images/favicons/favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${baseUrl}/images/icons/icon-192x192.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${baseUrl}/images/icons/icon-192x192.png`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${baseUrl}/images/icons/icon-512x512.png`} />
    <link rel="manifest" href={`${baseUrl}/manifest.webmanifest`} />

    <meta name="msapplication-TileColor" content={meta.color} />
    <meta name="theme-color" content={meta.color} />

    <SchemaOrg
      siteUrl={siteUrl}
      baseUrl={baseUrl}
      canonicalUrl={canonicalUrl}
      lang={locale}
      isSettings={isSettings}
    />

    <link rel="canonical" href={canonicalUrl} />
    {alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />

    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locales[locale].code.replace('-', '_')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={`${siteUrl}${baseUrl}/images/opengraph.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${siteUrl}${baseUrl}/images/opengraph.jpg`} />

    <script is:inline>
      // Astro wraps every navigation in a view transition, and taking its snapshot freezes rendering
      // for a few frames right in the middle of the app's own view animations. The router gets a plain
      // DOM swap instead; the native API is kept for the theme switch (except in WebKit on Windows,
      // where view transitions crash the page).
      (function () {
        var native = document.startViewTransition;
        var isWindowsWebKit =
          /WebKit/i.test(navigator.userAgent) && !/Chrome/i.test(navigator.userAgent) && /Windows/i.test(navigator.userAgent);
        if (native && !isWindowsWebKit) {
          window.__startViewTransition = native.bind(document);
        }
        try {
          Object.defineProperty(document, 'startViewTransition', {
            value: undefined,
            writable: true,
            configurable: true,
          });
        } catch (e) {}
      })();
    </script>
    <!-- The app animates its own views, so pages are swapped without the router's own cross-fade -->
    <ClientRouter fallback="swap" />

    <script is:inline>
      (function () {
        var earlyClicks = [];
        var isHydrated = function () {
          return document.documentElement.hasAttribute('data-app-hydrated');
        };

        document.addEventListener(
          'click',
          function (e) {
            if (!isHydrated()) {
              earlyClicks.push(e.target);
            }
          },
          true
        );

        function replayEarlyClicks() {
          if (earlyClicks.length > 0) {
            var targets = earlyClicks.slice();
            earlyClicks = [];
            setTimeout(function () {
              targets.forEach(function (target) {
                var clickable = (target.closest && target.closest('button, a, [role="button"], [role="tab"], input, label')) || target;
                if (clickable && (!('isConnected' in clickable) || clickable.isConnected) && typeof clickable.click === 'function') {
                  clickable.click();
                }
              });
            }, 0);
          }
        }

        window.addEventListener('app:hydrated', replayEarlyClicks);
      })();

      document.addEventListener('astro:after-swap', function () {
        document.documentElement.setAttribute('data-app-hydrated', 'true');
        window.__applyStoredTheme();
      });

      document.addEventListener('astro:before-swap', function (event) {
        var existingNewStyles = new Set();
        event.newDocument.head.querySelectorAll('style[data-emotion]').forEach(function (s) {
          existingNewStyles.add((s.getAttribute('data-emotion') || '') + ':' + s.textContent);
        });
        document.querySelectorAll('style[data-emotion]').forEach(function (s) {
          var key = (s.getAttribute('data-emotion') || '') + ':' + s.textContent;
          if (!existingNewStyles.has(key)) {
            event.newDocument.head.appendChild(s.cloneNode(true));
            existingNewStyles.add(key);
          }
        });
        var newBodyStyles = event.newDocument.body.querySelectorAll('style[data-emotion]');
        for (var j = 0; j < newBodyStyles.length; j++) {
          event.newDocument.head.appendChild(newBodyStyles[j]);
        }
      });
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
